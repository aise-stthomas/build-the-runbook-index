# Copy to .env. One Gemini key per student: https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here

# Optional: the models. Defaults are the course's text model and Gemini's embedding model.
# GEMINI_MODEL=gemini-3.1-flash-lite
# EMBEDDING_MODEL=gemini-embedding-001
# JUDGE_MODEL=gemini-3.1-flash-lite

# deploy.sh fills these in: a shared secret the function checks, and the service's URL
# LAB_TOKEN=
# LAB_URL=
